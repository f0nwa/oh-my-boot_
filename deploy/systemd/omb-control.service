[Unit]
Description=Oh My Boot HTTPS control dashboard
After=network-online.target postgresql.service omb-boot.service omb-agent.service
Wants=network-online.target

[Service]
Type=simple
User=omb-control
Group=omb-control
SupplementaryGroups=omb-images
EnvironmentFile=/etc/omb/control.env
ExecStart=/usr/local/bin/omb-control -listen ${OMB_CONTROL_LISTEN} -tls-cert /var/lib/omb-control/control.crt -tls-key /var/lib/omb-control/control.key -boot-socket /run/omb-boot/control.sock -agent-socket /run/omb/agent.sock -allowed-interfaces ${OMB_CONTROL_INTERFACES}
Restart=on-failure
StateDirectory=omb-control
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
