# Default deny at repository root; explicitly allow public project entries
/*

# Public root files
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.en.md
!/DESIGN.md
!/CONTEXT.md
!/go.mod
!/go.sum

# Public source, deployment, scripts, tests, and tooling directories
!/cmd/
!/deploy/
!/examples/
!/internal/
!/scripts/
!/testdata/
!/tools/

# Public user documentation
!/docs/
/docs/*
!/docs/brand/
!/docs/en/
!/docs/images/
!/docs/answer-editor.md
!/docs/architecture.md
!/docs/control-installation.md
!/docs/images-installation.md
!/docs/installation.md
!/docs/offline-installation.md
!/docs/offline-release.md
!/docs/secure-boot.md
!/docs/secure-boot-boot-paths.md
!/docs/secure-boot-sccm.md
!/docs/ubuntu-desktop-pxe.md
!/docs/windows-winpe-pxe.md
!/docs/windows11-winpe-pxe.md

# Common OS, build, and secret artifacts inside allowed directories
.DS_Store
__pycache__/
*.pyc
*.deb
*.bak
*.orig
*.tmp
.env
.env.*
*.key
*.pem
