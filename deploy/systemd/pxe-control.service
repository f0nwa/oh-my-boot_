[Unit]
Description=Oh My Boot HTTPS control dashboard
After=network-online.target postgresql.service pxe-boot.service pxe-agent.service
Wants=network-online.target

[Service]
Type=simple
User=pxe-control
Group=pxe-control
SupplementaryGroups=pxe-images
EnvironmentFile=/etc/pxe-platform/control.env
ExecStart=/usr/local/bin/pxe-control -listen ${PXE_CONTROL_LISTEN} -tls-cert /var/lib/pxe-platform-control/control.crt -tls-key /var/lib/pxe-platform-control/control.key -boot-socket /run/pxe-platform-boot/control.sock -agent-socket /run/pxe-platform/agent.sock -allowed-interfaces ${PXE_CONTROL_INTERFACES}
Restart=on-failure
StateDirectory=pxe-platform-control
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
