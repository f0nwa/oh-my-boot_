[Unit]
Description=Oh My Boot ISO catalog
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=omb-images
Group=omb-images
EnvironmentFile=/etc/omb/images.env
ExecStart=/usr/local/bin/omb-images
Restart=on-failure
RuntimeDirectory=omb-images
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/mnt/omb-smb-upload -/var/lib/omb-images
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
