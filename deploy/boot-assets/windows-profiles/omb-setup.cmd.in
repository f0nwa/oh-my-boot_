@echo off
set OMB_ISO_PASSWORD=__OMB_ISO_PASSWORD__
echo OMB: initializing network...
wpeinit
if errorlevel 1 goto failed
wpeutil WaitForNetwork
if errorlevel 1 goto failed

echo OMB: connecting installation media...
set /a OMB_ATTEMPT=0 >nul
:connect_media
set /a OMB_ATTEMPT+=1 >nul
if %OMB_ATTEMPT% GEQ 45 goto connect_final
net use Y: \\10.30.0.10\ombisos %OMB_ISO_PASSWORD% /user:omb-iso /persistent:no >nul 2>&1
if not errorlevel 1 goto media_ready
set OMB_NET_ERROR=%errorlevel%
echo OMB: media not ready (error %OMB_NET_ERROR%); retrying %OMB_ATTEMPT%/45...
ping -n 3 127.0.0.1 >nul
goto connect_media

:connect_final
net use Y: \\10.30.0.10\ombisos %OMB_ISO_PASSWORD% /user:omb-iso /persistent:no
if not errorlevel 1 goto media_ready
goto failed

:media_ready
if not exist Y:\__OMB_PROFILE_ID__\sources\__OMB_INSTALL_FILE__ goto failed
echo OMB: starting Windows Setup...
Y:\__OMB_PROFILE_ID__\sources\setup.exe /InstallFrom:Y:\__OMB_PROFILE_ID__\sources\__OMB_INSTALL_FILE__
if errorlevel 1 goto failed
exit /b 0

:failed
echo OMB: installation media is unavailable or Setup failed.
echo Check network connectivity and the ISO mount on the PXE server.
cmd /k
