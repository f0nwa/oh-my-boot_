  "$type": "CustomStartFolderSettings",
  "Settings": [
   {
    "Key": "PersonalFolder",
    "Value": false
   },
   {
    "Key": "Network",
    "Value": true
   },
   {
    "Key": "Videos",
    "Value": true
   },
   {
    "Key": "Pictures",
    "Value": false
   },
   {
    "Key": "Music",
    "Value": true
   },
   {
    "Key": "Downloads",
    "Value": true
   },
   {
    "Key": "Documents",
    "Value": false
   },
   {
    "Key": "FileExplorer",
    "Value": true
   },
   {
    "Key": "Settings",
    "Value": true
   }
  ]
 },
 "StickyKeysSettings": {
  "$type": "CustomStickyKeysSettings",
  "Flags": [
   "HotKeyActive",
   "TwoKeysOff",
   "HotKeySound"
  ]
 },
 "LockKeySettings": {
  "$type": "ConfigureLockKeySettings",
  "CapsLock": {
   "Initial": "Off",
   "Behavior": "Ignore"
  },
  "NumLock": {
   "Initial": "On",
   "Behavior": "Toggle"
  },
  "ScrollLock": {
   "Initial": "On",
   "Behavior": "Ignore"
  }
 },
 "ProcessAuditSettings": {
  "$type": "EnabledProcessAuditSettings",
  "IncludeCommandLine": true
 },
 "PESettings": {
  "$type": "GeneratePESettings",
  "PartitionSettings": {
   "$type": "UnattendedPartitionSettings",
   "TargetDiskSettings": {
    "$type": "FixedTargetDiskSettings",
    "Index": 0
   },
   "PartitionLayout": "GPT",
   "RecoveryMode": "Partition"
  },
  "InstallFromSettings": {
   "$type": "EditionInstallFromSettings",
   "Edition": "pro"
  },
  "PagingFileSettings": {
   "$type": "AutomaticPagingFileSettings"
  },
  "DisableDefender": true,
  "Disable8Dot3Names": true,
  "PauseBeforeFormatting": false,
  "PauseBeforeReboot": false,
  "CompactOs": false,
  "SkipIntegrityCheck": false
 }
}