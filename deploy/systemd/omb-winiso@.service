[Unit]
Description=Read-only Windows ISO profile %i for PXE installation
Wants=network-online.target
After=network-online.target remote-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omb-winiso-prepare %i
ExecStop=/usr/bin/umount /mnt/omb-iso/profiles/%i
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
