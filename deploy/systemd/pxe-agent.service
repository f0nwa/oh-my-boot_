[Unit]
Description=Oh My Boot network agent
After=network.target

[Service]
Type=simple
User=root
Group=pxe-control
ExecStart=/usr/local/bin/pxe-agent
Restart=on-failure
RuntimeDirectory=pxe-platform
RuntimeDirectoryMode=0750
StateDirectory=pxe-platform-agent
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/pxe-platform /etc/systemd/system /mnt/pxe-platform-smb /mnt/pxe-platform-smb-upload /mnt/pxe-platform-iso/profiles /run/pxe-platform /var/lib/pxe-platform-agent /srv/pxe/tftp/windows-profiles /srv/pxe/tftp/windows-answers /srv/pxe/tftp/windows-driver-wims /srv/pxe/tftp/windows-driver-configs -/run/samba
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
